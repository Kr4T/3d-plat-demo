      },
      "affects": "module",
      "min": 0,
      "max": 12,
      "step": 0.1
    },
    {
      "name": "stagger",
      "type": "number",
      "default": 0.35,
      "label": {
        "en": "Flinch (s)",
        "ar": "الارتداد (ث)"
      },
      "affects": "module",
      "min": 0,
      "max": 2,
      "step": 0.05
    }
  ]
