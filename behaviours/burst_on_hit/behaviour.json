{
  "format": "uew-behaviour@1",
  "type": "burst_on_hit",
  "name": {
    "en": "Sand burst on hit",
    "ar": "انفجار رملي عند الاصطدام"
  },
  "summary": {
    "en": "Throws a burst of sand at the point where the piece is hit (a physics contact, a combo or a hit reaction) or tapped in Play mode. Harder hits throw more sand.",
    "ar": "يقذف انفجارًا من الرمل عند نقطة اصطدام القطعة (تصادم فيزيائي أو ضربة متتالية أو رد فعل على ضربة) أو عند لمسها في وضع اللعب. الضربات الأقوى تقذف رملًا أكثر."
  },
  "targets": [
    "character",
    "piece",
    "animal"
  ],
  "params": [
    {
      "name": "size",
      "type": "number",
      "default": 2,
      "min": 0.5,
      "max": 12,
      "step": 0.1,
      "label": {
        "en": "Height thrown (m)",
        "ar": "ارتفاع القذف (م)"
      },
      "affects": "effect"
    },
    {
      "name": "count",
      "type": "number",
      "default": 600,
      "min": 50,
      "max": 2000,
      "step": 50,
      "label": {
        "en": "Grains (capped per device)",
        "ar": "الحبيبات (بحد لكل جهاز)"
      },
      "affects": "effect"
    },
    {
      "name": "duration",
      "type": "number",
      "default": 2,
      "min": 0.5,
      "max": 8,
      "step": 0.1,
      "label": {
        "en": "Duration (s)",
        "ar": "المدة (ث)"
      },
      "affects": "effect"
    },
    {
      "name": "colour",
      "type": "colour",
      "default": "#ffffff",
      "label": {
        "en": "Tint",
        "ar": "الصبغة"
      },
      "affects": "effect"
    },
    {
      "name": "minImpulse",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 100,
      "step": 0.5,
      "label": {
        "en": "Lightest hit that throws sand",
        "ar": "أخف ضربة تقذف الرمل"
      },
      "affects": "effect"
    },
    {
      "name": "fullImpulse",
      "type": "number",
      "default": 20,
      "min": 1,
      "max": 500,
      "step": 1,
      "label": {
        "en": "Hit for a full burst",
        "ar": "ضربة الانفجار الكامل"
      },
      "affects": "effect"
    }
  ]
}
